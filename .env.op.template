# Template for 1Password CLI injection. Copy to .env.op and point the
# references at your own vault items, then run:
#
#   op run --env-file=.env.op -- zwift-plan --hours 2
#
# The password is never written to disk by this tool and never logged.
ZWIFT_USER="op://Private/Zwift/username"
ZWIFT_PASS="op://Private/Zwift/password"
